[Unit]
Description=Nebula — the school app (gunicorn on 127.0.0.1:8020; tailnet via tailscale serve :8444)
After=network-online.target

[Service]
WorkingDirectory=%h/nebula
ExecStartPre=%h/nebula/.venv/bin/python manage.py migrate --noinput
ExecStartPre=%h/nebula/.venv/bin/python manage.py collectstatic --noinput
ExecStart=%h/nebula/.venv/bin/gunicorn nebula_site.wsgi -b 127.0.0.1:8020 -w 2 --timeout 120 --access-logfile %h/.local/share/nebula/access.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
